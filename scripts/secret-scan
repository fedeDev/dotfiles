#!/usr/bin/env python3
"""Scan source; show filenames/line numbers only, never matched values."""
from pathlib import Path
import re
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
files = subprocess.check_output(['git', '-C', str(root), 'ls-files', '-z', '--cached', '--others', '--exclude-standard']).decode().split('\0')
patterns = [r'gh[pousr]_[A-Za-z0-9]{30,}', r'github_pat_[A-Za-z0-9_]{30,}', r'-----BEGIN (?:RSA |OPENSSH |EC )?PRIVATE KEY-----', r'(?i)(?:token|password|secret|api_key)\s*=\s*[\x22\x27]?[A-Za-z0-9/+_-]{24,}']
# Also compare assigned live secret values, held in memory only.
local = Path.home() / '.zshrc.local'
secrets = []
if local.exists():
    for line in local.read_text().splitlines():
        match = re.match(r'\s*(?:export\s+)?\w*(?:TOKEN|PASSWORD|SECRET|API_KEY)\w*\s*=\s*(.*)', line)
        if match:
            value = match[1].strip().strip('\x22\x27')
            if len(value) >= 12:
                secrets.append(value)
findings = []
for name in sorted(set(files)):
    path = root / name
    if not name or not path.is_file() or path.is_symlink():
        continue
    try:
        lines = path.read_text().splitlines()
    except UnicodeError:
        continue
    for number, line in enumerate(lines, 1):
        if any(re.search(pattern, line) for pattern in patterns) or any(value in line for value in secrets):
            findings.append(f'{name}:{number}')
if findings:
    print('Potential secrets (values suppressed):\n' + '\n'.join(findings))
    sys.exit(1)
print('Source secret scan passed (patterns and current local secret comparison).')
