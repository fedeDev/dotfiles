#!/usr/bin/env python3
"""Explicit migration: preserve front config and add portable include once."""
from pathlib import Path
import os
import shutil
import subprocess
import datetime
import tempfile

home = Path.home()
front = home / '.config/git/config'
portable = home / '.config/git/portable.gitconfig'
if not portable.is_file() or portable.is_symlink():
    raise SystemExit('Apply portable.gitconfig as an ordinary file before running this script.')
backup_root = home / '.local/state/dotfiles-migration'
backup_root.mkdir(parents=True, mode=0o700, exist_ok=True)
backup = Path(tempfile.mkdtemp(prefix=datetime.datetime.now().strftime('git-%Y%m%d-%H%M%S-'), dir=backup_root))
os.chmod(backup, 0o700)
front.parent.mkdir(parents=True, exist_ok=True)
if front.exists():
    shutil.copyfile(front, backup / 'config')
    os.chmod(backup / 'config', 0o600)
if front.is_symlink():
    # Materialize exact existing contents, then update only our include entries.
    content = front.read_bytes()
    front.unlink()
    front.write_bytes(content)
    front.chmod(0o600)
elif not front.exists():
    front.touch(mode=0o600)
old = '~/.config/git/home-manager.gitconfig'
new = '~/.config/git/portable.gitconfig'
# Preserve include position so existing machine-local overrides keep precedence.
existing = subprocess.run(['git', 'config', '--file', str(front), '--get-all', 'include.path'], capture_output=True, text=True).stdout.splitlines()
if old in existing:
    if new in existing:
        subprocess.run(['git', 'config', '--file', str(front), '--fixed-value', '--unset-all', 'include.path', old], check=True)
    else:
        subprocess.run(['git', 'config', '--file', str(front), '--fixed-value', '--replace-all', 'include.path', new, old], check=True)
elif new not in existing:
    # Defaults precede machine-local settings, including on an already-written front.
    content = front.read_bytes()
    bom = b'\xef\xbb\xbf' if content.startswith(b'\xef\xbb\xbf') else b''
    prefix = ('[include]\n  path = ' + new + '\n').encode()
    front.write_bytes(bom + prefix + content[len(bom):])
print('Portable include added. Employer settings preserved. Private backup:', backup)
print('Inspect origins in Ghostty and another terminal; ~/.gitconfig can override XDG settings.')
